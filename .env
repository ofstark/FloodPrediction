# Comma-separated list of origins allowed to call this API (your Vite dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# How long (seconds) to cache live weather/soil/river data per zone before refetching
WEATHER_CACHE_TTL=600

# How long (seconds) to cache elevation/slope per zone (this data barely changes, cache long)
ELEVATION_CACHE_TTL=2592000

# --- Auth ---
# Single operator account. Username stays "Astra"; set your own password:
#   1) python scripts/generate_hash.py "your-chosen-password"
#   2) paste the printed hash below
ASTRA_USERNAME=Astra
ASTRA_PASSWORD_HASH=$2b$12$rdCUXsUs3fd/wab5YHmsM.DdnAb8ELzhi4aPy1HQiSd17EqOVTHpG

# Generate with: python scripts/generate_jwt_secret.py
